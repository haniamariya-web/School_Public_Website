<div class="space-y-6 max-w-4xl mx-auto">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to admin_franchise_applications_path, class: "text-gray-500 hover:text-british-red transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <% end %>
      <h1 class="text-2xl font-bold text-navy">Application Details</h1>
    </div>
    
    <div class="flex items-center space-x-3">
      <% if @application.status == 'payment_received' %>
        <%= button_to "Approve", admin_franchise_application_path(@application, status: 'approved'), method: :patch, class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded shadow-sm text-sm font-medium transition-colors cursor-pointer" %>
        <%= button_to "Reject", admin_franchise_application_path(@application, status: 'rejected'), method: :patch, class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded shadow-sm text-sm font-medium transition-colors cursor-pointer", form: { data: { turbo_confirm: "Are you sure you want to reject this application?" } } %>
      <% else %>
        <% status_color = case @application.status
           when 'pending_payment' then 'bg-yellow-100 text-yellow-800'
           when 'payment_received' then 'bg-blue-100 text-blue-800'
           when 'approved' then 'bg-green-100 text-green-800'
           when 'rejected' then 'bg-red-100 text-red-800'
           else 'bg-gray-100 text-gray-800' end %>
        <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full <%= status_color %>">
          <%= @application.status.titleize %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Applicant Information -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-bold text-navy mb-4 border-b pb-2">Applicant Information</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-500">Name</label>
          <div class="mt-1 text-gray-900"><%= @application.name %></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500">Email</label>
          <div class="mt-1 text-gray-900"><%= mail_to @application.email, class: "text-british-red hover:underline" %></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500">Phone</label>
          <div class="mt-1 text-gray-900"><%= @application.phone %></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500">Address</label>
          <div class="mt-1 text-gray-900 whitespace-pre-wrap"><%= @application.address %></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500">Applied On</label>
          <div class="mt-1 text-gray-900"><%= @application.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
        </div>
      </div>
    </div>

    <!-- Payment Information -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-bold text-navy mb-4 border-b pb-2">Payment Details</h2>
      <% if @application.franchise_payment.present? %>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-500">Status</label>
            <div class="mt-1">
              <% p_status_color = @application.franchise_payment.status == 'succeeded' ? 'text-green-600' : 'text-red-600' %>
              <span class="font-semibold <%= p_status_color %>"><%= @application.franchise_payment.status.titleize %></span>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-500">Amount</label>
            <div class="mt-1 text-gray-900"><%= number_to_currency(@application.franchise_payment.amount.to_f / 100) if @application.franchise_payment.amount %></div>
          </div>
          <% if @application.franchise_payment.stripe_payment_intent_id.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-500">Stripe Payment Intent ID</label>
              <div class="mt-1 text-gray-900 font-mono text-sm break-all"><%= @application.franchise_payment.stripe_payment_intent_id %></div>
            </div>
          <% end %>
          <% if @application.franchise_payment.card_last4.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-500">Card Last 4</label>
              <div class="mt-1 text-gray-900">•••• •••• •••• <%= @application.franchise_payment.card_last4 %></div>
            </div>
          <% end %>
          <% if @application.franchise_payment.paid_at.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-500">Paid At</label>
              <div class="mt-1 text-gray-900"><%= @application.franchise_payment.paid_at.strftime("%B %d, %Y at %I:%M %p") %></div>
            </div>
          <% end %>
          <% if @application.franchise_payment.receipt_url.present? %>
            <div class="pt-2">
              <%= link_to "View Stripe Receipt &rarr;".html_safe, @application.franchise_payment.receipt_url, target: "_blank", class: "text-british-red hover:underline font-medium text-sm" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-gray-500 flex flex-col items-center justify-center h-48 space-y-2">
          <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <p>No payment record found yet.</p>
          <p class="text-xs">The applicant has not completed the payment process.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
