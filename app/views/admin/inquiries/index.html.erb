


<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-light text-navy mb-2" style="font-family: 'Playfair Display', serif;">Inquiries</h1>
      <p class="text-gray-600">Manage all contact inquiries and admissions requests</p>
      <div class="w-20 h-1 bg-british-red mt-4"></div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-lg shadow-sm p-4 border-l-4 border-british-red">
        <p class="text-gray-600 text-sm font-medium">Total Inquiries</p>
        <p class="text-3xl font-bold text-navy mt-1"><%= @inquiries.count %></p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-4 border-l-4 border-yellow-500">
        <p class="text-gray-600 text-sm font-medium">Pending</p>
        <p class="text-3xl font-bold text-yellow-600 mt-1"><%= @pending_count %></p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-4 border-l-4 border-green-600">
        <p class="text-gray-600 text-sm font-medium">Contacted</p>
        <p class="text-3xl font-bold text-green-600 mt-1"><%= @contacted_count %></p>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-8 border border-gray-200">
      <%= form_with url: admin_inquiries_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4 items-end" do |f| %>
        <div class="md:col-span-1">
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Search Name</label>
          <%= f.text_field :name, value: params[:name], placeholder: "Enter name...", 
              maxlength: 50,
              pattern: "[A-Za-z\\s]*",
              title: "Only letters and spaces are allowed",
              oninput: "this.value = this.value.replace(/[^A-Za-z\\s]/g, '')",
              class: "block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-british-red/20 focus:border-british-red text-sm transition-all" %>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Status</label>
          <%= f.select :status, 
              options_for_select([["Pending Only", ""], ["Show All", "all"], ["Contacted", "contacted"], ["Closed", "closed"]], params[:status]), 
              {}, 
              class: "block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-british-red/20 focus:border-british-red text-sm transition-all appearance-none bg-white" %>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Grade Level</label>
          <%= f.select :grade, options_for_select([["All Grades", ""]] + @grades.map { |g| [g, g] }, params[:grade]), {}, 
              class: "block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-british-red/20 focus:border-british-red text-sm transition-all appearance-none bg-white" %>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Date Range</label>
          <%= f.select :date_range, 
              options_for_select([["Any Time", ""], ["Yesterday", "yesterday"], ["This Week", "this_week"], ["This Month", "this_month"], ["This Year", "this_year"]], params[:date_range]), 
              {}, 
              class: "block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-british-red/20 focus:border-british-red text-sm transition-all appearance-none bg-white" %>
        </div>

        <div class="md:col-span-4 flex justify-end gap-3 mt-2">
          <%= link_to "Clear Filters", admin_inquiries_path, class: "text-gray-500 hover:text-gray-700 text-sm font-medium px-4 py-2" %>
          <%= f.submit "Apply Filters", class: "bg-navy hover:bg-slate-800 text-white px-8 py-2 rounded-md text-sm font-bold transition shadow-sm cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Inquiries Table Wrapper -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <% if @inquiries.any? %>
        <!-- FIX 1: Add overflow-x-auto to allow horizontal scrolling on small screens -->
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 table-auto">
            <thead class="bg-gray-50">
              <tr>
                <!-- Use whitespace-nowrap to prevent headers from stacking -->
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Name</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Email</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Phone</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Grade</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Submitted</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Status</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @inquiries.each do |inquiry| %>
                <tr class="hover:bg-gray-50 transition">
                  <!-- FIX 2: Apply truncation helper -->
                  <td class="px-6 py-4 text-sm font-medium text-gray-900 whitespace-nowrap">
                    <%= truncate_with_hover(inquiry.name) %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap">
                    <%= truncate_with_hover(inquiry.email, 20) %> <!-- Emails get 20 chars -->
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap"><%= inquiry.phone %></td>
                  <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap"><%= inquiry.grade_level %></td>
                  <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap"><%= inquiry.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-6 py-4 text-sm whitespace-nowrap">
                    <% if inquiry.contacted? %>
                      <span class="inline-flex items-center gap-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold">
                        Contacted
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-xs font-semibold">
                        Pending
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-sm whitespace-nowrap">
                    <% if !inquiry.contacted? %>
                      <%= button_to "Mark Contacted", mark_contacted_admin_inquiry_path(inquiry), method: :patch, class: "bg-british-red hover:bg-red-700 text-white px-4 py-2 rounded text-xs font-semibold transition shadow-sm" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <p class="text-gray-500 text-lg font-medium">No inquiries yet</p>
          <p class="text-gray-400 text-sm mt-1">Inquiries will appear here when submitted</p>
        </div>
      <% end %>
    </div>
  </div>
</div>