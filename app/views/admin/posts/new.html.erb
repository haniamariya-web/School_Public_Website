<h1 class="text-3xl font-bold text-navy mb-6">New Post</h1>

<%= form_with model: [:admin, @post], local: true, html: { multipart: true, class: "bg-white p-6 rounded shadow space-y-6" } do |f| %>
  <% if @post.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <h2 class="font-bold"><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% @post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6">
    <section class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <h2 class="text-xl font-semibold text-navy mb-4">Post details</h2>

      <div class="mb-5">
        <%= f.label :title, class: "block text-navy font-semibold mb-2" %>
        <%= f.text_field :title, required: true, maxlength: 140, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-british-red" %>
      </div>

      <div>
        <%= f.label :content, "Content", class: "block text-navy font-semibold mb-2" %>
        <%= f.text_area :content, rows: 5, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-british-red" %>
        <p class="text-xs text-gray-500 mt-2">Optional when you upload media. Use this field for captions, descriptions, or announcements.</p>
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <h2 class="text-xl font-semibold text-navy mb-4">Media upload</h2>
      <p class="text-sm text-gray-500 mb-4">Upload one media file only. Size limit: 10MB</p>

      <div class="mb-4 file-upload-wrapper">
        <%= f.label :media, "Media file", class: "block text-navy font-semibold mb-2" %>
        <%= f.file_field :media, accept: "image/png,image/jpeg,image/jpg,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime", class: "w-full border border-gray-300 rounded-lg px-4 py-3 bg-white text-sm text-gray-700 cursor-pointer focus:outline-none focus:ring-2 focus:ring-british-red", data: { controller: "file-size", action: "change->file-size#validate", "file-size-max-value": 10485760 } %>
        <p class="text-xs text-gray-500 mt-2">Accepts image or video formats.</p>
        <p class="file-size-message mt-2 text-sm text-red-600" aria-live="polite"></p>
        <% if @post.errors[:media].any? %>
          <p class="mt-2 text-sm text-red-600"><%= @post.errors.full_messages_for(:media).join(", ") %></p>
        <% end %>
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <h2 class="text-xl font-semibold text-navy mb-4">Publication settings</h2>

      <div class="mb-5">
        <%= f.label :campus_id, "Campus", class: "block text-navy font-semibold mb-2" %>
        <%= f.collection_select :campus_id, Campu.all, :id, :name, { include_blank: "Select Campus" }, { required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-british-red" } %>
      </div>
    </section>
  </div>

  <div class="flex flex-wrap gap-2 justify-end">
    <%= f.submit "Create Post", class: "bg-british-red text-white px-5 py-3 rounded-lg hover:bg-red-700 transition font-medium" %>
    <%= link_to "Cancel", admin_posts_path, class: "bg-gray-500 text-white px-5 py-3 rounded-lg hover:bg-gray-600 transition" %>
  </div>
<% end %>
