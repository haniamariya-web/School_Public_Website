<div class="min-h-[70vh] flex items-center justify-center bg-gray-50 px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-2xl w-full space-y-8 text-center">
    <div>
      <h1 class="text-9xl font-extrabold text-navy font-playfair tracking-tight">404</h1>
      <h2 class="mt-6 text-4xl font-bold text-navy font-playfair">Page Not Found</h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">
        Sorry, we couldn't find the page you're looking for. It might have been removed, renamed, or the link is incorrect.
      </p>
    </div>
    <div class="mt-10 flex justify-center space-x-4">
      <%= link_to "Go Back Home", root_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-navy hover:bg-blue-900 transition-colors shadow-sm" %>
    </div>
  </div>
</div>
