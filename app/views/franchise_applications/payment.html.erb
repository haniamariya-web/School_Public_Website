<div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8 mt-10"
     data-controller="stripe-payment"
     data-stripe-payment-public-key-value="<%= Rails.application.credentials.dig(:stripe, :publishable_key) %>"
     data-stripe-payment-client-secret-value="<%= @client_secret %>"
     data-stripe-payment-return-url-value="<%= franchise_applications_success_url %>">
  
  <h1 class="text-3xl font-bold text-navy mb-2">Complete Payment</h1>
  <p class="text-gray-600 mb-6">Pay the franchise fee to complete your application</p>

  <div class="bg-gray-50 p-4 rounded-lg mb-6">
    <p class="text-sm text-gray-600">Applicant: <strong><%= @franchise_application.name %></strong></p>
    <p class="text-sm text-gray-600">Franchise Fee: <strong class="text-navy">$500</strong></p>
  </div>

  <div data-stripe-payment-target="paymentElement" class="min-h-[200px]"></div>
  
  <button data-stripe-payment-target="submitButton" data-action="click->stripe-payment#submit" class="w-full bg-british-red text-white py-3 rounded-lg hover:bg-red-700 transition font-semibold mt-4 disabled:opacity-50">
    Pay $500
  </button>
  
  <div data-stripe-payment-target="errorMessage" class="text-red-600 text-sm mt-2"></div>
</div>