<div style="font-family: sans-serif; border: 1px solid #ddd; padding: 20px; border-radius: 8px;">
  <h2 style="color: #2c3e50;">New Admission Inquiry</h2>
  <p>You have received a new inquiry from the website. Here are the details:</p>
  
  <hr style="border: 0; border-top: 1px solid #eee;">
  
  <p><strong>Name:</strong> <%= @inquiry.name %></p>
  <p><strong>Email:</strong> <%= @inquiry.email %></p>
  <p><strong>Message:</strong></p>
  <div style="background: #f9f9f9; padding: 15px; border-left: 4px solid #2c3e50;">
    <%= @inquiry.message %>
  </div>
  
  <p style="margin-top: 20px;">
    <a href="mailto:<%= @inquiry.email %>" style="background: #2c3e50; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
      Reply to Applicant
    </a>
  </p>
</div>