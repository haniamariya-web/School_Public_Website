<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-100">
  <%= render "admin/shared/navbar" %>

  <main class="p-8 max-w-7xl mx-auto">
    <div data-controller="flash" data-flash-timeout-value="7000">
      <% flash.each do |type, message| %>
        <div class="mb-6 rounded-xl px-5 py-4 text-sm font-medium <%= type == 'notice' ? 'bg-emerald-100 text-emerald-900 border border-emerald-200' : 'bg-red-100 text-red-900 border border-red-200' %>">
          <%= message %>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </main>
</body>
</html>